# Copy to `.env` and fill in (do not commit `.env`).
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# Single project for local dev and production: sgttsotrvemmgmujcuay (see supabase/config.toml).
# Keys: Supabase Dashboard → Project Settings → API → Project API keys → anon (public)
# If you omit these, the app falls back to this project’s URL + anon key (so Render builds work without env).
# Set them when you need a different Supabase project or after rotating the anon key.

VITE_SUPABASE_URL=https://sgttsotrvemmgmujcuay.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only (never VITE_): create demo logins for every employee email — npm run seed:demo-auth
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_DEFAULT_PASSWORD=BoomEoDemo2026!
# DEMO_ADMIN_EMAIL=bunmi.akinyemiju@peopleos.co

# Optional: URL or site-relative path to the demo 360 spreadsheet (e.g. /data/your-file.xlsx with file in public/data/).
VITE_DEMO_APPRAISAL_XLSX_PATH=

# Optional: legacy admin demo login (disabled if either is empty). VITE_ values are still visible in the client bundle—do not use in production.
VITE_LEGACY_ADMIN_EMAIL=
VITE_LEGACY_ADMIN_PASSWORD=
VITE_LEGACY_ADMIN_NAME=

# Keep built-in app AI paths (chat/resources/insights) enabled.
# Set to false only if you intentionally want to disable AI surfaces.

