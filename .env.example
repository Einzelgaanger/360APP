# Copy to `.env` and fill in (do not commit `.env`).
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: URL or site-relative path to the demo 360 spreadsheet (e.g. /data/your-file.xlsx with file in public/data/).
VITE_DEMO_APPRAISAL_XLSX_PATH=

# Optional: legacy admin demo login (disabled if either is empty). VITE_ values are still visible in the client bundle—do not use in production.
VITE_LEGACY_ADMIN_EMAIL=
VITE_LEGACY_ADMIN_PASSWORD=
VITE_LEGACY_ADMIN_NAME=
